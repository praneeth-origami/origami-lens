{
  "manifest_version": 3,
  "name": "Origami Lens",
  "version": "0.1.0",
  "description": "Find what's wrong with any webpage.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": [
    "http://localhost:3100/*",
    "http://127.0.0.1:3100/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png"
  }
}
