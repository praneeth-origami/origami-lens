# Origami API
API_PORT=3100
API_HOST=0.0.0.0
BROWSER_WORKER_URL=http://localhost:3101
AI_ROUTER_URL=http://localhost:3102

# Browser Worker
BROWSER_WORKER_PORT=3101
BROWSER_WORKER_HOST=0.0.0.0
CHROMIUM_EXECUTABLE_PATH=

# AI Router (vLLM or Ollama OpenAI-compatible API)
AI_ROUTER_PORT=3102
VLLM_BASE_URL=http://localhost:11434/v1
VLLM_API_KEY=not-needed-for-local
AI_ENABLED=true
AI_TEXT_MODEL=qwen2.5:7b
# Vision model for Screenshot -> Code (and visual_qa). Set this to whatever tag
# your provider actually serves it under — Ollama's registry names often
# differ from the architecture doc's display names (e.g. "qwen3-vl:8b-instruct"
# on Ollama vs. "Qwen3-VL-8B-Instruct" in the docs).
AI_VISION_MODEL=qwen3-vl:8b-instruct

# AI_CODE_MODEL: the coding model for Screenshot -> Code's generate_component
# stage. THIS IS THE KNOB THAT MUST MATCH YOUR AVAILABLE GPU MEMORY. Every
# generation runs the vision model above, then this one — Ollama does not
# keep both resident at once on a small GPU, so this model's weight size has
# to fit the same VRAM budget the vision model already uses.
#
#   Local development (<= ~6-8GB VRAM, e.g. a single RTX 3050):
#     AI_CODE_MODEL=qwen2.5:7b        # ~4.7GB weights — already pulled for AI_TEXT_MODEL above, no extra download
#   Production (real GPU headroom — A100/H100, a dedicated inference box, etc.):
#     AI_CODE_MODEL=qwen3-coder:30b   # ~18GB weights — the architecture doc's "Qwen3-Coder-Next"
#
# Application code never hardcodes either name — this variable is the only
# place the coding model is chosen. It feeds both TASK_MODEL_MAP.generate_component
# (services/ai-router/src/gateway.ts) and the resource-fit check described by
# AI_GPU_VRAM_MB below.
AI_CODE_MODEL=qwen2.5:7b

# Best-effort GPU VRAM budget in megabytes (e.g. read off `nvidia-smi`'s total
# memory column). Used ONLY to flag AI_VISION_MODEL/AI_CODE_MODEL as
# resource-constrained when their on-disk weight size doesn't realistically
# fit — this is what readyForComponentGeneration in GET /health/dependencies
# and the "Code generation could not be completed with the current AI
# configuration" error are based on. Leave unset to skip this check entirely
# (readiness then falls back to "is the model name registered with the
# server", the pre-existing behavior).
AI_GPU_VRAM_MB=6144

# Per-call timeout in ms for screenshot_to_code (and every AI task except
# generate_component, which has its own budget below). AI_GATEWAY_TIMEOUT_MS
# (component-generator.ts's outer budget, calling the AI Router) must always
# be LARGER than the largest inner budget it wraps (gateway.ts's per-task
# timeout, calling the model server) — an outer timeout tighter than the
# inner one it wraps just wastes the model's work and reports the wrong
# failure. Unset falls back to the historical defaults (140000/45000 inner
# for Ollama/vLLM, 150000 outer), sized for a large production model; a
# right-sized local model should finish comfortably inside a much tighter
# budget, so set both lower in development for faster, more useful failures
# instead of multi-minute hangs.
AI_MODEL_TIMEOUT_MS=60000

# generate_component's own timeout, independent of AI_MODEL_TIMEOUT_MS above.
# Code generation and vision analysis are different workloads — vision
# produces a small fixed-shape structured description, while code generation
# can legitimately need close to its full output-token budget for a complex
# real component. Sharing one timeout under-serves whichever stage needs more
# room. Derived from real measured production data on this project's dev
# GPU: qwen2.5:7b generates at ~26.7 tokens/sec (steady, not throttled), and
# generate_component's own MAX_TOKENS_BY_TASK cap is 4096 — 4096/26.7 ~= 153s
# worst case, plus ~8s model-reload overhead (this GPU can't hold both the
# vision and code models at once) and ~3s prompt evaluation, plus a ~15s
# safety margin, rounds to 180000. On production hardware sized for the full
# Qwen3-Coder-Next model this should be re-measured and likely lowered — this
# default is calibrated to THIS project's small dev GPU, same as
# AI_MODEL_TIMEOUT_MS above.
AI_CODE_GENERATION_TIMEOUT_MS=180000

# Must exceed the LARGER of AI_MODEL_TIMEOUT_MS and
# AI_CODE_GENERATION_TIMEOUT_MS.
AI_GATEWAY_TIMEOUT_MS=195000

# Repository embeddings (Phase 4 — BGE-M3 + pgvector). These are all read by
# services/ai-router/src/embedding-provider.ts and apps/api/src/repository-embedding-provider.ts,
# independently of every AI_MODEL_TIMEOUT_MS/AI_CODE_GENERATION_TIMEOUT_MS
# setting above — embeddings are a structurally different workload (batch
# vector calls, not chat completions) and must never share a chat task's
# timeout or model routing.
#
# AI_EMBED_MODEL was already referenced (as a fallback default) by
# gateway.ts's TASK_MODEL_MAP.repository_search before this phase existed —
# reused here rather than introducing a second variable for the same
# concept. Set it to whatever tag your provider actually serves BGE-M3
# under (e.g. Ollama: "bge-m3", after `ollama pull bge-m3`).
AI_EMBED_MODEL=BGE-M3

# Per-call timeout in ms for one embedding batch request.
AI_EMBED_TIMEOUT_MS=30000

# Max chunks sent to the embedding model in a single request — never the
# whole repository in one call. BGE-M3 via Ollama's OpenAI-compatible
# endpoint accepts a batch `input` array natively (verified against a real
# local instance during development), so this is a true batch size, not a
# client-side loop count.
AI_EMBED_BATCH_SIZE=16

# A chunk whose constructed embedding input (file/symbol header + code)
# approximately exceeds this many tokens is skipped (not failed) rather than
# sent — protects against a pathological chunk consuming the model's entire
# context window. No real BGE-M3 tokenizer is wired into this project; this
# budget is checked via a conservative ~4-characters-per-token approximation.
AI_EMBED_MAX_INPUT_TOKENS=2000

# Bounded concurrency for embedding batch calls within one job — kept
# conservative (not the worker's own BullMQ job concurrency, which stays at
# 1) so this never competes aggressively with Screenshot -> Code's GPU usage
# on a small development GPU that can't hold multiple models resident at once.
AI_EMBED_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Phase 5 — Repository semantic search + reranking
# (apps/api/src/repository-search-service.ts, services/ai-router/src/reranker-provider.ts)
# ---------------------------------------------------------------------------

# Query validation: a search query longer than this (after trimming) is
# rejected with SEARCH_QUERY_INVALID before ever reaching the embedding model.
REPOSITORY_SEARCH_MAX_QUERY_LENGTH=500

# Bounded candidate set retrieved from pgvector before reranking — the whole
# repository is never reranked, only this many nearest-neighbor candidates.
REPOSITORY_SEARCH_CANDIDATE_K=50

# Hard ceiling on the final response's result count, regardless of what a
# caller requests via `limit` in the request body.
REPOSITORY_SEARCH_RESULT_LIMIT=10

# Chunk content returned to the API is truncated to this many characters —
# never a full file, never unbounded.
REPOSITORY_SEARCH_MAX_CONTENT_CHARS=600

# Timeout for embedding a single search query (BGE-M3, reusing the Phase 4
# provider) — its own dedicated budget, never AI_EMBED_TIMEOUT_MS (that one
# is sized for a whole indexing batch, not one short query string).
AI_QUERY_EMBEDDING_TIMEOUT_MS=10000

# Phase 6 — a real bge-reranker-v2-m3 deployment (Hugging Face Text
# Embeddings Inference, GPU-backed) runs via the `reranker` docker-compose
# service; see docker-compose.yml for image/GPU-architecture selection
# notes. Verified live against that deployment during Phase 6 — see the
# Phase 6 report's live-verification section.

# Must be the exact Hugging Face repo id (never a short display name) —
# TEI's --model-id argument (docker-compose.yml) downloads the model
# directly from this repo, and a short name like "bge-reranker-v2-m3"
# (without the "BAAI/" owner prefix) 404s against huggingface.co (verified
# live during Phase 6). Never hard-coded elsewhere in application code —
# only read from this variable.
AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Base URL of the dedicated reranker model server, called only from
# services/ai-router/src/reranker-provider.ts — never routed through /gateway
# and never called directly by apps/api. Port 8001 matches the `reranker`
# service's published port in docker-compose.yml.
AI_RERANKER_BASE_URL=http://localhost:8001
AI_RERANKER_API_KEY=not-needed

# Per-call timeout in ms for one rerank request — its own dedicated budget,
# never AI_CODE_GENERATION_TIMEOUT_MS or AI_EMBED_TIMEOUT_MS.
AI_RERANKER_TIMEOUT_MS=15000

# Max candidates ever sent to the reranker in one request — bounded
# separately from REPOSITORY_SEARCH_CANDIDATE_K so the two can be tuned
# independently, though they default to the same value. Enforced by apps/api
# (apps/api/src/repository-reranker-provider.ts, which builds the candidate
# list) AND validated by services/ai-router/src/reranker-provider.ts's
# resolveRerankerConfig() against AI_RERANKER_MAX_CLIENT_BATCH_SIZE below —
# see that variable's comment for the required relationship.
AI_RERANKER_MAX_CANDIDATES=50

# The real TEI reranker server's own `--max-client-batch-size` (see the
# `reranker` service's `command:` in docker-compose.yml) — the hard
# per-request item-count ceiling that server actually enforces. This value
# must be kept in sync with that docker-compose argument by hand (compose
# reads the same env var, so in practice they can't drift as long as both
# come from this file) — TEI's own factory default (32) rejects a full
# 50-candidate batch outright with HTTP 413 ("batch size 50 > maximum
# allowed batch size 32"), verified live during Phase 6.
#
# REQUIRED RELATIONSHIP (enforced at AI Router startup as of Phase 7 — see
# resolveRerankerConfig() in services/ai-router/src/reranker-provider.ts):
#   AI_RERANKER_MAX_CANDIDATES <= AI_RERANKER_MAX_CLIENT_BATCH_SIZE
# Violating this used to fail silently: every real search would still
# return HTTP 200 with reranked:false (every rerank request 413'd, caught
# as a RerankerProviderError, and search quietly degraded to vector-only
# ordering — no error, no log anyone would notice). Phase 7 made this throw
# a clear RerankerConfigurationError at config-resolution time instead,
# which crashes AI Router startup rather than letting search quality
# degrade invisibly. If you raise AI_RERANKER_MAX_CANDIDATES, raise this
# value (and the matching --max-client-batch-size argument in
# docker-compose.yml) to at least the same number first.
AI_RERANKER_MAX_CLIENT_BATCH_SIZE=64

# Every document sent to the reranker is truncated to this many characters
# first (services/ai-router/src/reranker-provider.ts) — verified live that
# TEI rejects the ENTIRE batch (HTTP 413) if even a single document exceeds
# its 8192-token per-input limit, so this is a hard safety bound, not a
# tuning knob for reranking quality.
AI_RERANKER_MAX_DOCUMENT_CHARS=6000

# Max HTTP request body size (megabytes), applied to both apps/api and
# services/ai-router's Fastify instances (each reads this independently,
# same variable). Fastify defaults to 1MB, which is too small for
# POST /components and its onward POST /gateway relay: a Screenshot -> Code
# evidence payload bundles a base64 screenshot (cropped to the selection +
# margin, JPEG q=0.85 — base64 itself adds ~37% overhead) plus a trimmed DOM
# tree (depth <= 4, <= 25 children/node), <= 20 asset entries, and CSS
# variables. A large selection on a high-DPR display can plausibly exceed
# 1MB from the screenshot alone. 8MB comfortably covers that realistic worst
# case while staying a small, bounded limit rather than an unbounded one.
MAX_REQUEST_BODY_MB=8

# Website Scan
# Default page budget for an Entire Website Scan when a request doesn't
# specify its own maxPages. Always clamped to MAX_WEBSITE_PAGES (50, a fixed
# safety ceiling defined in code — not configurable here).
WEBSITE_SCAN_MAX_PAGES=20

# ---------------------------------------------------------------------------
# Phase 9 — Repository AI Assistant (grounded code Q&A)
# (apps/api/src/repository-ai-service.ts, apps/api/src/repository-ai-context.ts,
#  services/ai-router/src/repository-qa-provider.ts)
# ---------------------------------------------------------------------------

# How many top reranked candidates POST /repositories/:id/ask requests from
# the existing Phase 5/6 search pipeline before context-bounding — separate
# from REPOSITORY_SEARCH_RESULT_LIMIT so it can be tuned independently.
AI_REPOSITORY_QA_MAX_RESULT_CHUNKS=10

# Total LLM context budget across all included chunks, in characters (no
# real BGE-M3/text-model tokenizer is wired into this project — see
# AI_EMBED_MAX_INPUT_TOKENS's own note for the same conservative ~4-chars/
# token reasoning applied here). Complete chunks are always preserved —
# once a chunk would push the total past this budget, it (and every
# lower-ranked chunk after it) is left out entirely, never truncated
# mid-string.
AI_REPOSITORY_QA_MAX_CONTEXT_CHARS=12000

# A single chunk's content is truncated to this many characters before it
# is ever assembled into context — bounds any one pathologically large
# chunk so it alone can never consume the entire AI_REPOSITORY_QA_MAX_CONTEXT_CHARS
# budget.
AI_REPOSITORY_QA_MAX_CHUNK_CHARS=4000

# Per-call timeout in ms for the repository Q&A LLM call — its own
# dedicated budget, never AI_MODEL_TIMEOUT_MS, AI_CODE_GENERATION_TIMEOUT_MS,
# AI_ISSUE_ANALYSIS_TIMEOUT_MS, or AI_FIX_PROPOSAL_TIMEOUT_MS. A Q&A answer
# is a single bounded chat-completion call over a handful of retrieved
# chunks, the same workload shape as Phase 8's issue analysis (60s default).
AI_REPOSITORY_QA_TIMEOUT_MS=60000

# Output token budget for the answer itself (a prose explanation, not
# generated source code) — deliberately smaller than generate_component's
# budget.
AI_REPOSITORY_QA_MAX_TOKENS=1024

# apps/api's own client-side timeout for calling the AI Router's
# POST /answer-repository-question — kept slightly above
# AI_REPOSITORY_QA_TIMEOUT_MS so the client never gives up before the
# server-side call had a chance to finish or time out on its own.
AI_REPOSITORY_QA_CLIENT_TIMEOUT_MS=65000

# ---------------------------------------------------------------------------
# Phase 10 — AI issue analysis + code fix proposal for a website-scan finding
# (apps/api/src/repository-finding-fix-service.ts, repository-fix-context.ts,
#  services/ai-router/src/repository-finding-fix-provider.ts)
# ---------------------------------------------------------------------------

# How many top reranked candidates POST /repositories/:id/findings/:findingId/
# fix-proposal requests from the reused Phase 5/6 search pipeline — separate
# from AI_REPOSITORY_QA_MAX_RESULT_CHUNKS so the two can be tuned independently.
AI_FINDING_FIX_MAX_RESULT_CHUNKS=10

# Repository-context budget for the finding-fix prompt, in characters — its
# own dedicated budget (see AI_REPOSITORY_QA_MAX_CONTEXT_CHARS's own note for
# the ~4-chars/token reasoning), reused via the same bounding algorithm as
# Phase 9's context builder (buildRepositoryQaContext), just with this value.
AI_REPOSITORY_FIX_MAX_CONTEXT_CHARS=12000

# A finding's evidence (selector/message/snippet — scanner-produced, not
# trusted code) is bounded independently before being included in the prompt.
AI_FINDING_EVIDENCE_MAX_CHARS=2000

# Per-call timeout in ms for the finding fix-proposal LLM call — its own
# dedicated budget, never AI_MODEL_TIMEOUT_MS (reusing it would recreate the
# generate_component/screenshot_to_code workload mismatch previously
# discovered in this project), AI_CODE_GENERATION_TIMEOUT_MS,
# AI_ISSUE_ANALYSIS_TIMEOUT_MS, AI_FIX_PROPOSAL_TIMEOUT_MS, or
# AI_REPOSITORY_QA_TIMEOUT_MS. Sized like Phase 8's AI_FIX_PROPOSAL_TIMEOUT_MS
# since this task also produces structured code changes, not just prose.
AI_REPOSITORY_FIX_TIMEOUT_MS=90000
# Bugfix: was 2048 — a real proposal (multiple files/hunks, each with real
# code in oldText/newText) is the same "multi-file source" shape
# gateway.ts's own MAX_TOKENS_BY_TASK already sizes at 4096 for
# generate_component/fix_code. 2048 was observed live truncating a real
# response mid-string ("Unterminated string in JSON..."), which was then
# misreported as the provider being unavailable rather than the real cause
# (the model ran out of output budget — finish_reason "length").
AI_REPOSITORY_FIX_MAX_TOKENS=4096

# apps/api's own client-side timeout for calling the AI Router's
# POST /propose-finding-fix — kept slightly above AI_REPOSITORY_FIX_TIMEOUT_MS.
AI_REPOSITORY_FIX_CLIENT_TIMEOUT_MS=95000

# Proposal-validation limits (server-enforced, never trusted from the AI
# response alone) — scan findings are typically localized to one component/
# stylesheet, so these default lower than Phase 8's repository-issue fix
# proposals, biasing toward the smallest-reasonable-change principle.
AI_FINDING_FIX_MAX_FILES=3
AI_FINDING_FIX_MAX_HUNKS_PER_FILE=5
AI_FINDING_FIX_MAX_PROPOSAL_BYTES=20000

# Phase 11 — safe AI fix application (POST /repositories/:id/findings/:findingId/fix-proposal/apply).
# Root directory under which every isolated fix-application workspace gets
# its own <repositoryId>/<applicationId> subdirectory. A copy of the
# repository clone, never the clone itself — deliberately a separate root
# from REPOSITORY_CLONE_ROOT so a workspace can never be mistaken for a real
# clone. Defaults alongside SCAN_DATA_DIR/.origami-data like every other
# repository storage root in this project.
REPOSITORY_FIX_WORKSPACE_ROOT=./.origami-data/repository-fix-workspaces
# How long a workspace RETAINED for Phase 12 review (see below) stays
# approvable before it and its repository_fix_workflows row expire. Phase
# 11's own stateless /fix-proposal/apply never retains a workspace at all,
# so this value only governs Phase 12's review -> approve flow.
REPOSITORY_FIX_WORKSPACE_TTL_MS=3600000

# Phase 12 — Git branch + commit + Pull Request workflow
# (POST /repositories/:id/findings/:findingId/fix-proposal/review then
# .../fix-proposal/approve). Nothing below is ever used unless the user
# explicitly clicks "Create Pull Request" — generating or applying a fix
# proposal never triggers any of this on its own.

# How often the server sweeps reviewed-but-never-approved fix applications
# past their REPOSITORY_FIX_WORKSPACE_TTL_MS and discards their workspace.
REPOSITORY_FIX_WORKFLOW_CLEANUP_INTERVAL_MS=300000

# Git author identity used ONLY for the commit created on a generated fix
# branch — never written to any global/persistent git config, never used
# for any other commit in this project. Both are required: if either is
# missing, approval fails with GIT_COMMIT_IDENTITY_MISSING before any git
# mutation happens.
GIT_COMMIT_NAME=Origami AI
GIT_COMMIT_EMAIL=ai@origami.dev

# A GitHub Personal Access Token (or GitHub App installation token) with
# `repo` scope (push + pull request) on whichever repositories this server
# will be asked to open fix PRs against. Server-side configuration ONLY —
# never stored per-repository, never in the database, never sent to the
# frontend. If unset, approval fails with GIT_AUTH_NOT_CONFIGURED before any
# push is attempted. See repository-github-provider-client.ts.
GITHUB_TOKEN=
# Override only for testing against a mock GitHub API server.
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TIMEOUT_MS=15000

# Phase 13 — GitLab support for the same fix-PR workflow (a repository with
# provider GITLAB). A GitLab personal/project access token with `api` scope
# (read + write access, including Merge Requests) on whichever projects
# this server will be asked to open fix MRs against. Server-side
# configuration ONLY — same rules as GITHUB_TOKEN above. If unset, approval
# fails with GIT_AUTH_NOT_CONFIGURED before any push is attempted. See
# repository-gitlab-provider-client.ts.
GITLAB_TOKEN=
# Override only for a self-managed GitLab instance or a mock API server.
GITLAB_API_BASE_URL=https://gitlab.com/api/v4
GITLAB_API_TIMEOUT_MS=15000

# Phase 16/D — real, per-user GitLab push/MR authorization via OAuth
# (replaces GITLAB_TOKEN above as the production credential path — see
# repository-gitlab-provider-client.ts's resolveToken). Create an
# application at https://gitlab.com/-/user_settings/applications (or your
# self-managed instance's equivalent under /-/profile/applications) with
# scope `api` and a callback URL of exactly
# http://localhost:5173/providers/gitlab/callback (proxied to the API the
# same way GITHUB_OAUTH_CALLBACK_URL is). GITLAB_TOKEN above remains a
# documented fallback ONLY until this is configured — once configured,
# every user's GitLab credential comes from their own OAuth connection,
# never the shared token.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_REDIRECT_URI=http://localhost:5173/providers/gitlab/callback

# Phase 16/D — the server-side key used to encrypt GitLab (and future
# Bitbucket) OAuth access/refresh tokens before they are ever written to
# Postgres (provider_connections.encrypted_access_token/
# encrypted_refresh_token — migration 013). GitHub needs no equivalent: its
# installation tokens are minted fresh and never stored (see
# github-app-auth.ts). Generate a real 32-byte key and base64-encode it,
# e.g. `openssl rand -base64 32` — never reuse this value across
# environments, never commit it, never log it.
CREDENTIAL_ENCRYPTION_KEY=

# Phase 13 — Bitbucket support for the same fix-PR workflow (a repository
# with provider BITBUCKET). Bitbucket Cloud's API requires the real account
# username paired with an App Password (Bitbucket has no "any username"
# convention the way GitHub/GitLab do) — both are server-side configuration
# ONLY, same rules as GITHUB_TOKEN above. If either is unset, approval fails
# with GIT_AUTH_NOT_CONFIGURED before any push is attempted. See
# repository-bitbucket-provider-client.ts.
BITBUCKET_USERNAME=
BITBUCKET_TOKEN=
# Override only for testing against a mock Bitbucket API server.
BITBUCKET_API_BASE_URL=https://api.bitbucket.org/2.0
BITBUCKET_API_TIMEOUT_MS=15000

# Phase 16/E — real, per-user Bitbucket push/PR authorization via OAuth
# (replaces BITBUCKET_USERNAME/BITBUCKET_TOKEN above as the production
# credential path — see repository-bitbucket-provider-client.ts's
# resolveCredential). Create an OAuth consumer at
# https://bitbucket.org/<your-workspace>/workspace/settings/oauth-consumers
# with "This is a private consumer" checked, permissions Account (Read),
# Repositories (Write), Pull requests (Write), and a callback URL of
# exactly http://localhost:5173/providers/bitbucket/callback (proxied to
# the API the same way GITHUB_OAUTH_CALLBACK_URL is). BITBUCKET_USERNAME/
# BITBUCKET_TOKEN above remain a documented fallback ONLY until this is
# configured — once configured, every user's Bitbucket credential comes
# from their own OAuth connection, never the shared App Password.
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=
BITBUCKET_OAUTH_REDIRECT_URI=http://localhost:5173/providers/bitbucket/callback

# Phase 16/A — Origami Lens's own application login (a `users` row + a
# server-side session), via GitHub OAuth. This is NOT the same credential as
# GITHUB_TOKEN/the GitHub provider client above — that's about pushing to a
# specific repository; this is about proving who a signed-in Origami Lens
# user is. Register a GitHub OAuth App at
# https://github.com/settings/developers ("New OAuth App") with its
# "Authorization callback URL" set to exactly GITHUB_OAUTH_CALLBACK_URL
# below, then copy its Client ID/Secret here. Requires DATABASE_URL to be
# configured — see user-repository.ts/session-repository.ts: there is
# deliberately no in-memory fallback for authentication data.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Must exactly match the callback URL configured on the GitHub OAuth App.
# In local dev this should point at the frontend's own origin (proxied to
# the API by apps/web/vite.config.ts's /auth proxy entry) so the session
# cookie set by the callback response is scoped to the same origin the
# frontend's own fetch() calls use — see the Phase 16 design report's
# authenticated-request-model notes on same-origin cookies via the dev proxy.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/auth/github/callback
# Where the browser is redirected after a successful login.
WEB_APP_BASE_URL=http://localhost:5173
# How long an Origami Lens session stays valid before requiring a fresh
# GitHub OAuth login. Default: 30 days.
SESSION_TTL_MS=2592000000

# Phase 16/C — real, per-user GitHub push/PR authorization via a GitHub App
# (replaces the single global GITHUB_TOKEN as the production credential
# path — see repository-github-provider-client.ts's getPushCredentials).
# Create a GitHub App at https://github.com/settings/apps/new (NOT an OAuth
# App — this is a different, separate registration from the login app
# above): Repository permissions -> Contents: Read and write, Pull
# requests: Read and write; no account/org permissions needed. Set its
# "Setup URL" to exactly http://localhost:5173/providers/github/callback
# (proxied to the API the same way GITHUB_OAUTH_CALLBACK_URL is) and check
# "Redirect on update". After creating it, generate a private key (a .pem
# download) and copy the three values below. GITHUB_TOKEN above remains a
# documented fallback ONLY until this is configured — once it is, every
# user's push/PR credential comes from their own GitHub App installation,
# never the shared token.
GITHUB_APP_ID=
# The app's numeric client ID's PEM private key — .env cannot hold a real
# multi-line file, so paste it with real newlines replaced by literal
# "\n" (github-app-auth.ts unescapes this automatically). Never commit
# this value or share it outside this local, gitignored .env file.
GITHUB_APP_PRIVATE_KEY=
# The app's URL slug (from its settings page URL, e.g.
# github.com/settings/apps/<this-slug>) — used to build the "Install App"
# link at GET /providers/github/connect.
GITHUB_APP_SLUG=

# Database (future)
DATABASE_URL=postgresql://origami:origami@localhost:5433/origami_lens

# Redis / Valkey (future queues)
REDIS_URL=redis://localhost:6379

# Object Storage (future)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=origami
MINIO_SECRET_KEY=origami-secret
MINIO_BUCKET=origami-artifacts
