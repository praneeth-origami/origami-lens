# Origami API
API_PORT=3100
API_HOST=0.0.0.0
BROWSER_WORKER_URL=http://localhost:3101
AI_ROUTER_URL=http://localhost:3102

# Browser Worker
BROWSER_WORKER_PORT=3101
BROWSER_WORKER_HOST=0.0.0.0
CHROMIUM_EXECUTABLE_PATH=

# AI Router (vLLM or Ollama OpenAI-compatible API)
AI_ROUTER_PORT=3102
VLLM_BASE_URL=http://localhost:11434/v1
VLLM_API_KEY=not-needed-for-local
AI_ENABLED=true
AI_TEXT_MODEL=qwen2.5:7b
# Vision model for Screenshot -> Code (and visual_qa). Set this to whatever tag
# your provider actually serves it under — Ollama's registry names often
# differ from the architecture doc's display names (e.g. "qwen3-vl:8b-instruct"
# on Ollama vs. "Qwen3-VL-8B-Instruct" in the docs).
AI_VISION_MODEL=qwen3-vl:8b-instruct

# AI_CODE_MODEL: the coding model for Screenshot -> Code's generate_component
# stage. THIS IS THE KNOB THAT MUST MATCH YOUR AVAILABLE GPU MEMORY. Every
# generation runs the vision model above, then this one — Ollama does not
# keep both resident at once on a small GPU, so this model's weight size has
# to fit the same VRAM budget the vision model already uses.
#
#   Local development (<= ~6-8GB VRAM, e.g. a single RTX 3050):
#     AI_CODE_MODEL=qwen2.5:7b        # ~4.7GB weights — already pulled for AI_TEXT_MODEL above, no extra download
#   Production (real GPU headroom — A100/H100, a dedicated inference box, etc.):
#     AI_CODE_MODEL=qwen3-coder:30b   # ~18GB weights — the architecture doc's "Qwen3-Coder-Next"
#
# Application code never hardcodes either name — this variable is the only
# place the coding model is chosen. It feeds both TASK_MODEL_MAP.generate_component
# (services/ai-router/src/gateway.ts) and the resource-fit check described by
# AI_GPU_VRAM_MB below.
AI_CODE_MODEL=qwen2.5:7b

# Best-effort GPU VRAM budget in megabytes (e.g. read off `nvidia-smi`'s total
# memory column). Used ONLY to flag AI_VISION_MODEL/AI_CODE_MODEL as
# resource-constrained when their on-disk weight size doesn't realistically
# fit — this is what readyForComponentGeneration in GET /health/dependencies
# and the "Code generation could not be completed with the current AI
# configuration" error are based on. Leave unset to skip this check entirely
# (readiness then falls back to "is the model name registered with the
# server", the pre-existing behavior).
AI_GPU_VRAM_MB=6144

# Per-call timeout in ms for screenshot_to_code (and every AI task except
# generate_component, which has its own budget below). AI_GATEWAY_TIMEOUT_MS
# (component-generator.ts's outer budget, calling the AI Router) must always
# be LARGER than the largest inner budget it wraps (gateway.ts's per-task
# timeout, calling the model server) — an outer timeout tighter than the
# inner one it wraps just wastes the model's work and reports the wrong
# failure. Unset falls back to the historical defaults (140000/45000 inner
# for Ollama/vLLM, 150000 outer), sized for a large production model; a
# right-sized local model should finish comfortably inside a much tighter
# budget, so set both lower in development for faster, more useful failures
# instead of multi-minute hangs.
AI_MODEL_TIMEOUT_MS=60000

# generate_component's own timeout, independent of AI_MODEL_TIMEOUT_MS above.
# Code generation and vision analysis are different workloads — vision
# produces a small fixed-shape structured description, while code generation
# can legitimately need close to its full output-token budget for a complex
# real component. Sharing one timeout under-serves whichever stage needs more
# room. Derived from real measured production data on this project's dev
# GPU: qwen2.5:7b generates at ~26.7 tokens/sec (steady, not throttled), and
# generate_component's own MAX_TOKENS_BY_TASK cap is 4096 — 4096/26.7 ~= 153s
# worst case, plus ~8s model-reload overhead (this GPU can't hold both the
# vision and code models at once) and ~3s prompt evaluation, plus a ~15s
# safety margin, rounds to 180000. On production hardware sized for the full
# Qwen3-Coder-Next model this should be re-measured and likely lowered — this
# default is calibrated to THIS project's small dev GPU, same as
# AI_MODEL_TIMEOUT_MS above.
AI_CODE_GENERATION_TIMEOUT_MS=180000

# Must exceed the LARGER of AI_MODEL_TIMEOUT_MS and
# AI_CODE_GENERATION_TIMEOUT_MS.
AI_GATEWAY_TIMEOUT_MS=195000

# Max HTTP request body size (megabytes), applied to both apps/api and
# services/ai-router's Fastify instances (each reads this independently,
# same variable). Fastify defaults to 1MB, which is too small for
# POST /components and its onward POST /gateway relay: a Screenshot -> Code
# evidence payload bundles a base64 screenshot (cropped to the selection +
# margin, JPEG q=0.85 — base64 itself adds ~37% overhead) plus a trimmed DOM
# tree (depth <= 4, <= 25 children/node), <= 20 asset entries, and CSS
# variables. A large selection on a high-DPR display can plausibly exceed
# 1MB from the screenshot alone. 8MB comfortably covers that realistic worst
# case while staying a small, bounded limit rather than an unbounded one.
MAX_REQUEST_BODY_MB=8

# Website Scan
# Default page budget for an Entire Website Scan when a request doesn't
# specify its own maxPages. Always clamped to MAX_WEBSITE_PAGES (50, a fixed
# safety ceiling defined in code — not configurable here).
WEBSITE_SCAN_MAX_PAGES=20

# Database (future)
DATABASE_URL=postgresql://origami:origami@localhost:5433/origami_lens

# Redis / Valkey (future queues)
REDIS_URL=redis://localhost:6379

# Object Storage (future)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=origami
MINIO_SECRET_KEY=origami-secret
MINIO_BUCKET=origami-artifacts
